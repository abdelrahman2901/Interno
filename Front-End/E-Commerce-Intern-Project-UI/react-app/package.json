{
  "name": "react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "generate:interno-microservice-client": "nswag run src/Core/API/Interno-Microservice-Client/Interno-Microservice-Client.json && node scripts/patch-interno-client.mjs && node scripts/strip-api-prefix.mjs src/Core/API/Interno-Microservice-Client/Interno-Microservice-Client.ts",
    "generate:audit-microservice-client": "nswag run src/Core/API/Audit-Microservice-Client/Audit-Microservice-Client.json && node scripts/strip-api-prefix.mjs src/Core/API/Audit-Microservice-Client/Audit-Microservice-Client.ts",
    "generate:notification-microservice-client": "nswag run src/Core/API/Notification-Microservice-Cleint/Notification-Microservice-Cleint.json && node scripts/strip-api-prefix.mjs src/Core/API/Notification-Microservice-Cleint/Notifications-Microservice-Client.ts",
    "generate:api": "npm run generate:interno-microservice-client && npm run generate:audit-microservice-client && npm run generate:notification-microservice-client"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "bootstrap": "^5.3.8",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0",
    "redux": "^5.0.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@vitejs/plugin-react": "^3.1.0",
    "nswag": "^14.7.1",
    "typescript": "^4.9.3",
    "vite": "^4.1.0"
  }
}
