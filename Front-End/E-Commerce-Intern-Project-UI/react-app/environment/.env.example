# Vite loads these from /environment (see vite.config.ts envDir).
#
# npm run dev        -> .env.docker      (vite --mode docker)
# npm run dev:https  -> .env.https       (vite --mode https)
# npm run build      -> .env.production  (vite --mode production)

# Gateway
# Docker:      http://localhost:5003/gateway
# HTTPS local: https://localhost:7110/gateway
# Production:  https://internogateway.runasp.net/gateway
VITE_GATEWAY_URL=http://localhost:5003/gateway

# Static files (products / banners / categories)
# Docker:      http://localhost:5000
# HTTPS local: https://localhost:7164
# Production:  https://internoapi.runasp.net
VITE_FILES_BASE_URL=http://localhost:5000

# External services
VITE_AVATAR_API_URL=https://ui-avatars.com/api
