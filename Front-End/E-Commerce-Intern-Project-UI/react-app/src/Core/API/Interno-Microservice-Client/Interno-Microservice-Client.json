{
    "runtime": "Net80",
    "documentGenerator": {
      "fromDocument": {
       "url": "http://localhost:5000/swagger/v1/swagger.json",
       "output": null
    }
  },
  "codeGenerators": {
    "openApiToTypeScriptClient": {
      "className": "InternoMicroserviceClient",
      "template": "Axios",
      "promiseType": "Promise",
      "typeStyle": "Class",
      "enumStyle": "Enum",
      "generateDtoTypes": true,
      "generateConstructorInterface": true,
      "markOptionalProperties": true,
      "typeScriptVersion": 4.9,
      "serviceHost":"localhost:5003/gateway",
      "serviceSchemes": ["http"],
      "output": "Interno-Microservice-Client.ts"
    }
  }
}