{
  "runtime": "Net80",
  "documentGenerator": {
    "fromDocument": {
      "url": "https://localhost:7164/swagger/v1/swagger.json",
      "output": null
    }
  },
  "codeGenerators": {
    "openApiToTypeScriptClient": {
      "className": "InternoMicroserviceClient",
      "template": "Axios",
      "promiseType": "Promise",
      "typeStyle": "Class",
      "enumStyle": "Enum",
      "generateDtoTypes": true,
      "generateConstructorInterface": true,
      "markOptionalProperties": true,
      "typeScriptVersion": 4.9,
      "serviceHost": "localhost:7110/gateway",
      "serviceSchemes": ["https"],
      "output": "Interno-Microservice-Client.ts"
    }
  }
}
